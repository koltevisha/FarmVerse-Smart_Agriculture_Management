package edu.infosys.farmVerseApplication.service;

import java.lang.reflect.Field;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import edu.infosys.farmVerseApplication.bean.AgroExpense;
import edu.infosys.farmVerseApplication.bean.Crop;
import edu.infosys.farmVerseApplication.bean.CropExpense;
import edu.infosys.farmVerseApplication.bean.CropInputs;
import edu.infosys.farmVerseApplication.bean.Farm;
import edu.infosys.farmVerseApplication.bean.FarmCropInputs;
import edu.infosys.farmVerseApplication.bean.FarmCropReport;
import edu.infosys.farmVerseApplication.dao.AgroExpenseDao;
import edu.infosys.farmVerseApplication.dao.CropDao;
import edu.infosys.farmVerseApplication.dao.CropInputsDao;
import edu.infosys.farmVerseApplication.dao.FarmDao;

@Service
public class CropInputsService {

    @Autowired
    private CropDao cropDao;

    @Autowired
    private FarmUserService service;

    @Autowired
    private FarmDao farmDao;

    @Autowired
    private AgroExpenseDao agroExpDao;

    @Autowired
    private CropInputsDao inputsDao;


    // ============================================================
    // GET FARM + CROP INFORMATION
    // ============================================================

    public FarmCropInputs setFarmCropInputData(String cropId) {

        Crop crop = cropDao.getCropById(cropId);

        if (crop == null) {
            return null;
        }

        Farm farm = farmDao.getFarmById(crop.getFarmId());

        if (farm == null) {
            return null;
        }

        return new FarmCropInputs(
                crop,
                farm.getSoil()
        );
    }


    // ============================================================
    // CREATE CROP INPUT DATA
    // ============================================================

    public CropInputs setCropInputData(
            FarmCropInputs farmCropInputs) {

        CropInputs cropInputs =
                new CropInputs(farmCropInputs);

        /*
         * Agro Tools is always fixed to 1 unit.
         * AI does not decide this value.
         */
        cropInputs.setAgroTools(1.0);

        return cropInputs;
    }


    // ============================================================
    // OLD EXPENSE CALCULATION
    // ============================================================

    public void expenseCalculationOld(String cropId) {

        List<AgroExpense> expenseList =
                agroExpDao.getAllExpense();

        Map<String, AgroExpense> expenseMap =
                new HashMap<>();

        for (AgroExpense ae : expenseList) {

            expenseMap.put(
                    ae.getExpenseName(),
                    ae
            );
        }


        CropInputs cropInputs =
                inputsDao.getCropInputsById(cropId);

        if (cropInputs == null) {

            System.out.println(
                    "Crop Inputs not found for cropId: "
                    + cropId
            );

            return;
        }


        Class<?> clazz =
                cropInputs.getClass();

        Field[] fields =
                clazz.getDeclaredFields();

        Double totValue = 0.0;


        try {

            for (Field fd : fields) {

                fd.setAccessible(true);

                String fieldName =
                        fd.getName();

                if (fieldName.equalsIgnoreCase("cropId")) {
                    continue;
                }


                AgroExpense ae =
                        expenseMap.get(fieldName);


                if (ae != null) {

                    Double inputValue;


                    /*
                     * Agro Tools is always 1.
                     */
                    if (fieldName.equalsIgnoreCase(
                            "agroTools")) {

                        inputValue = 1.0;

                    } else {

                        Object value =
                                fd.get(cropInputs);

                        if (value == null) {
                            inputValue = 0.0;
                        } else {
                            inputValue =
                                    Double.parseDouble(
                                            value.toString()
                                    );
                        }
                    }


                    Double expense =
                            ae.getRatePerUnit()
                                    * inputValue;


                    System.out.println(
                            ae.getExpenseName()
                            + " -> Input: "
                            + inputValue
                            + " × Rate: "
                            + ae.getRatePerUnit()
                            + " = "
                            + expense
                    );


                    totValue =
                            totValue + expense;
                }
            }

        } catch (Exception ex) {

            ex.printStackTrace();
        }


        System.out.println(
                "Total Cost Per Acre: "
                + totValue
        );
    }


    // ============================================================
    // MAIN EXPENSE CALCULATION
    // ============================================================

    public FarmCropReport expenseCalculation(
            String cropId) {


        // --------------------------------------------------------
        // GET ALL EXPENSE RATES
        // --------------------------------------------------------

        List<AgroExpense> expenseList =
                agroExpDao.getAllExpense();


        Map<String, AgroExpense> expenseMap =
                new HashMap<>();


        for (AgroExpense ae : expenseList) {

            expenseMap.put(
                    ae.getExpenseName(),
                    ae
            );
        }


        // --------------------------------------------------------
        // GET CROP INPUTS
        // --------------------------------------------------------

        CropInputs cropInputs =
                inputsDao.getCropInputsById(cropId);


        if (cropInputs == null) {

            System.out.println(
                    "Crop Inputs not found for cropId: "
                    + cropId
            );

            return null;
        }


        // --------------------------------------------------------
        // CREATE CROP EXPENSE OBJECT
        // --------------------------------------------------------

        CropExpense cropExpense =
                new CropExpense();

        cropExpense.setCropId(
                cropInputs.getCropId()
        );


        Double totalValue = 0.0;


        // --------------------------------------------------------
        // GET CROP INPUT FIELDS
        // --------------------------------------------------------

        Class<?> clazz =
                cropInputs.getClass();

        Field[] fields =
                clazz.getDeclaredFields();


        try {

            for (Field fd : fields) {

                fd.setAccessible(true);


                String fieldName =
                        fd.getName();


                // Skip crop ID

                if (fieldName.equalsIgnoreCase(
                        "cropId")) {

                    continue;
                }


                // ------------------------------------------------
                // FIND MATCHING EXPENSE
                // ------------------------------------------------

                AgroExpense ae =
                        expenseMap.get(fieldName);


                if (ae == null) {

                    continue;
                }


                Double inputValue;


                // =================================================
                // AGRO TOOLS
                // ALWAYS 1 UNIT
                // =================================================

                if (fieldName.equalsIgnoreCase(
                        "agroTools")) {

                    inputValue = 1.0;

                }

                // =================================================
                // OTHER INPUTS
                // READ FROM DATABASE
                // =================================================

                else {

                    Object value =
                            fd.get(cropInputs);


                    if (value == null) {

                        inputValue = 0.0;

                    } else {

                        inputValue =
                                Double.parseDouble(
                                        value.toString()
                                );
                    }
                }


                // ------------------------------------------------
                // CALCULATE EXPENSE
                // ------------------------------------------------

                Double expense =
                        ae.getRatePerUnit()
                                * inputValue;


                totalValue =
                        totalValue + expense;


                // ------------------------------------------------
                // PRINT CALCULATION
                // ------------------------------------------------

                System.out.println(
                        ae.getExpenseName()
                        + " -> Input: "
                        + inputValue
                        + " × Rate: "
                        + ae.getRatePerUnit()
                        + " = "
                        + expense
                );


                // ------------------------------------------------
                // SET CROP EXPENSE
                // ------------------------------------------------

                if (fieldName.equalsIgnoreCase(
                        "waterGallon")) {

                    cropExpense.setWaterGallon(
                            expense
                    );

                }

                else if (fieldName.equalsIgnoreCase(
                        "fertilizer")) {

                    cropExpense.setFertilizer(
                            expense
                    );

                }

                else if (fieldName.equalsIgnoreCase(
                        "pesticides")) {

                    cropExpense.setPesticides(
                            expense
                    );

                }

                else if (fieldName.equalsIgnoreCase(
                        "tractorHour")) {

                    cropExpense.setTractorHour(
                            expense
                    );

                }

                else if (fieldName.equalsIgnoreCase(
                        "agroTools")) {

                    cropExpense.setAgroTools(
                            expense
                    );
                }
            }


        } catch (Exception ex) {

            ex.printStackTrace();
        }


        // ============================================================
        // GET CROP
        // ============================================================

        Crop crop =
                cropDao.getCropById(cropId);


        if (crop == null) {

            System.out.println(
                    "Crop not found: "
                    + cropId
            );

            return null;
        }


        // ============================================================
        // GET FARM
        // ============================================================

        Farm farm =
                farmDao.getFarmById(
                        crop.getFarmId()
                );


        if (farm == null) {

            System.out.println(
                    "Farm not found for farmId: "
                    + crop.getFarmId()
            );

            return null;
        }


        // ============================================================
        // CREATE FINAL REPORT
        // ============================================================

        FarmCropReport farmCropReport =
                new FarmCropReport(
                        farm,
                        crop,
                        cropInputs,
                        cropExpense,
                        totalValue
                );


        // ============================================================
        // PRINT FINAL REPORT
        // ============================================================

        System.out.println(
                "======================================"
        );

        System.out.println(
                "Crop ID       : "
                + cropId
        );

        System.out.println(
                "Water Expense : "
                + cropExpense.getWaterGallon()
        );

        System.out.println(
                "Fertilizer    : "
                + cropExpense.getFertilizer()
        );

        System.out.println(
                "Pesticides    : "
                + cropExpense.getPesticides()
        );

        System.out.println(
                "Tractor       : "
                + cropExpense.getTractorHour()
        );

        System.out.println(
                "Agro Tools    : "
                + cropExpense.getAgroTools()
        );

        System.out.println(
                "TOTAL EXPENSE : "
                + totalValue
        );

        System.out.println(
                "======================================"
        );


        return farmCropReport;
    }
}